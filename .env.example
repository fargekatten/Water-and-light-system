# Eksempel; filen lastes ikke automatisk. Sett variablene i terminalen.
THINGSPEAK_CHANNEL_ID=YOUR_CHANNEL_ID
THINGSPEAK_READ_API_KEY=YOUR_READ_API_KEY
HUE_BRIDGE_HOST=YOUR_BRIDGE_HOSTNAME
HUE_USERNAME=YOUR_HUE_USERNAME
# Valgfritt: sertifikatfil for Hue-broens CA. Vertsnavnet må stemme med sertifikatet.
# HUE_CA_FILE=/path/to/trusted-hue-ca.pem
ARDUINO_PORT=COM7
SOUND_THRESHOLD=100
