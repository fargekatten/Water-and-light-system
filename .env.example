# Set these in your shell; this file is not loaded automatically.
HUE_BRIDGE_HOST=YOUR_BRIDGE_HOSTNAME
HUE_USERNAME=YOUR_HUE_USERNAME
# HUE_CA_FILE=/path/to/trusted-hue-ca.pem
HUE_LIGHT_IDS=4,5,6
ARDUINO_PORT=COM7
ROOM_TIMEZONE=Europe/Oslo
# keep = retain existing lights outside 07–11; same = all day; off = switch off
OUTSIDE_HOURS=off
# Optional old ThingSpeak viewer only; not used for responsive lighting:
THINGSPEAK_CHANNEL_ID=YOUR_CHANNEL_ID
THINGSPEAK_READ_API_KEY=YOUR_READ_API_KEY
